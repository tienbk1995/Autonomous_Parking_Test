          <mxGeometry x="560" y="1360" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="startm" target="validm">
