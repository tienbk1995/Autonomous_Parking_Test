        <mxCell id="pe4" value="No: freeSpots ≥ 5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="loop" target="parked">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe5" value="No: position ≥ 500" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="loop" target="fail">
